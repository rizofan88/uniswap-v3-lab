{
  "name": "uniswap-v3-lab",
  "scripts": {
    "fork": "anvil --fork-url mainnet --fork-block-number -10 --fork-chain-id 1 --chain-id 1",
    "swap:local": "hardhat run scripts/swap.ts --network localhost",
    "quote": "tsx scripts/quote.ts",
    "test:forge": "forge test --fork-url localhost -vvv",
    "api": "tsx server/api.ts",
    "test-bal": "cast call 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2 'balanceOf(address)' 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266  --rpc-url",
    "test-dep": "cast send 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2 'deposit()' --value 1ether --from 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266  --unlocked --rpc-url",
    "rm": "rm state/sessions/* state/ports.json port-* 2> /dev/null",
    "kill": "ps | grep 'port 85*' | grep -v grep | awk '{print $1}' | xargs -J {} kill {}"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "hardhat": "^2.22.18",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "@uniswap/sdk-core": "^7.3.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v3-sdk": "^3.23.0",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1"
  }
}
